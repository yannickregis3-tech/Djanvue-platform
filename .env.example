# Supabase — identifiants publics (aucune clé service-role dans le navigateur)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Connexion PostgreSQL directe facultative ; privilégier Supabase et ses politiques RLS
DATABASE_URL=

# Cloudflare R2 — secrets serveur uniquement
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=djanvue-media
R2_PUBLIC_BASE_URL=

# Ne renseigner que si un mécanisme JWT dédié l'exige
JWT_SECRET=
